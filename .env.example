# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (shared by all services + docker-compose.infra.yml)
DB_USERNAME=your_db_user_here
DB_PASSWORD=your_db_password_here

# Keycloak admin console password (docker-compose.infra.yml)
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here

# Keycloak client secret for core-service-admin-client (core-service, fulfillment-service)
KEYCLOAK_ADMIN_CLIENT_SECRET=your_keycloak_client_secret_here
